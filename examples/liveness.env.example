# Credentials the liveness probe reads BY NAME from the environment.
#
# POLICY.md's `liveness` table never holds a secret. It holds the NAME of an environment variable,
# and the gate reads the value at probe time. Nothing here is ever printed in a verdict, in an
# error, or in a report.
#
# Copy to `.env.local` (gitignored) and fill in real values, or export these however your machine
# already handles secrets.
#
# EVERY NAME STARTS WITH `PANDORAS_`. The probe refuses to read a variable outside that prefix, so
# a policy row can only ever reach a secret minted for the probe, never a key that happens to be
# in the environment. (Configurable: `probeLiveness({ envPrefix })`.)
#
# ── a public URL needs nothing at all ─────────────────────────────────────────────────────────
# POLICY.md:   | `web` | https://web.example.com/ | - | - | - |
# No variable. No credential. Most rows look like this.
#
# ── HTTP basic auth ───────────────────────────────────────────────────────────────────────────
# POLICY.md:   | `repo-a` | https://repo-a.example.com/health | `build-ok` | `basic:PANDORAS_REPO_A_PROBE_AUTH` | 8000 |
# The value is `user:password`. The gate base64-encodes it into an Authorization header. An
# already-encoded `Basic xxxx` value is passed through rather than double-encoded.
PANDORAS_REPO_A_PROBE_AUTH=probe-user:replace-me

# ── a session cookie ──────────────────────────────────────────────────────────────────────────
# POLICY.md:   | `docs` | https://docs.example.com/ | `build-ok` | `cookie:PANDORAS_DOCS_PROBE_COOKIE` | - |
# The value is the whole Cookie header, e.g. `session=abc123`.
PANDORAS_DOCS_PROBE_COOKIE=session=replace-me

# ── a custom header, for a deployment gated by a token ────────────────────────────────────────
# POLICY.md:   | `api` | https://api.example.com/status | `build-ok` | `header:X-Deploy-Token:PANDORAS_API_PROBE_TOKEN` | - |
PANDORAS_API_PROBE_TOKEN=replace-me

# IF A VARIABLE IS UNSET, THE GATE SKIPS. It does NOT send the request bare and grade the 401:
# that would measure the credential rather than the deployment. The skip says which variable was
# missing, and a skip is never a pass.
