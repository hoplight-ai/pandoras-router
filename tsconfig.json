// tsconfig.json — the type checker reads the JSDoc already in the source. Nothing is compiled.
//
// The trade: zero RUNTIME dependencies are kept, and the two tools this check needs are vendored
// rather than fetched. `dependencies` stays empty; the TypeScript compiler and Node's type
// declarations sit in `devDependencies` at exact pinned versions, recorded with their integrity
// hashes in the committed package-lock.json, and are installed by `npm ci --ignore-scripts`.
// test/typecheck.mjs points the compiler at that install, so `npm test` fetches nothing at run
// time. An editor with no Node types installed will show Node globals as unknown, and the npm
// script is the check of record.
//
// The source stays plain JavaScript (.mjs). `checkJs` holds every JSDoc `@param`, `@returns` and
// `@typedef` to the code it describes; a mismatch is a comment and its code disagreeing.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true
  },
  "include": ["src", "hooks", "test"]
}
